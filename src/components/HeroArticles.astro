---

---

<section class="hero">
  <div class="spotlight"></div>
  <div class="grain"></div>

  <!-- ORBIT RINGS — populated by JS -->
  <div class="orbits" id="orbits">
    <div class="orbit-center">
      <div class="orbit-center-dot"></div>
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <div class="content">
    <div class="eyebrow">Articles</div>

    <div class="headline">
      <div class="hl-line">
        <span class="hl-line-inner">the art of</span>
      </div>
      <div class="hl-line">
        <span class="hl-line-inner">knowing</span>
      </div>
      <div class="hl-line">
        <span class="hl-line-inner"
          ><span class="hl-gold">deeply.</span><span class="type-cursor"
          ></span></span
        >
      </div>
    </div>

    <p class="subtext">
      Long-form technical writing that doesn't cut corners. Each article is a
      full reckoning with an idea — written to be understood, not skimmed.
    </p>
  </div>

  <div class="side-label">blessbycode · articles</div>
  <div class="h-rule"></div>
</section>

<style is:inline>
  /* ── HERO ── */
  .hero {
    position: relative;
    width: 100%;
    height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
  }

  /* deep amber spotlight */
  .spotlight {
    position: absolute;
    top: -20%;
    left: -10%;
    width: 70vw;
    height: 120vh;
    background: radial-gradient(
      ellipse at 30% 40%,
      rgba(200, 140, 40, 0.12) 0%,
      rgba(160, 100, 20, 0.06) 30%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
    animation: spotBreath 8s ease-in-out infinite;
  }
  @keyframes spotBreath {
    0%,
    100% {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
    50% {
      transform: scale(1.08) translateY(-20px);
      opacity: 0.8;
    }
  }

  /* grain */
  .grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.04;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)'/%3E%3C/svg%3E");
    background-size: 180px;
  }

  /* ── ORBIT RINGS ── */
  .orbits {
    position: absolute;
    right: 5vw;
    top: 50%;
    transform: translateY(-50%);
    width: min(70vh, 700px);
    height: min(70vh, 700px);
    z-index: 2;
    pointer-events: none;
  }
  .orbit-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    animation: spin var(--spd, 30s) linear infinite;
  }

  .orbits:hover .orbit-ring {
    animation-play-state: paused;
  }
  .orbits:hover .orbit-ring .orbit-label {
    opacity: 1;
    color: #eed080;
  }
  .orbit-ring:nth-child(even) {
    animation-direction: reverse;
  }

  /* ring visual border */
  .orbit-ring::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(200, 168, 64, 0.08);
    pointer-events: none;
  }
  .orbits:hover .orbit-ring::before {
    border-color: rgba(200, 168, 64, 0.22);
  }

  /* orbit labels positioned around the ring */
  .orbit-label {
    position: absolute;
    font-family: var(--font-mono);
    font-size: clamp(0.52rem, 0.65vw, 0.65rem);
    letter-spacing: 0.08em;
    white-space: nowrap;
    color: rgba(200, 168, 64, 0.28);
    transition:
      color 0.3s,
      opacity 0.3s;
    transform-origin: center;
    /* counter-rotate so text stays upright */
    animation: counterSpin var(--spd, 30s) linear infinite;
  }
  .orbit-ring:nth-child(even) .orbit-label {
    animation-direction: reverse;
  }
  .orbits:hover .orbit-ring .orbit-label {
    animation-play-state: paused;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes counterSpin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-360deg);
    }
  }

  /* center glow */
  .orbit-center {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 3;
  }
  .orbit-center-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c8a840;
    box-shadow:
      0 0 20px rgba(200, 168, 64, 0.6),
      0 0 60px rgba(200, 168, 64, 0.2);
    animation: dotPulse 3s ease-in-out infinite;
  }
  @keyframes dotPulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow:
        0 0 20px rgba(200, 168, 64, 0.6),
        0 0 60px rgba(200, 168, 64, 0.2);
    }
    50% {
      transform: scale(1.4);
      box-shadow:
        0 0 30px rgba(200, 168, 64, 0.8),
        0 0 80px rgba(200, 168, 64, 0.3);
    }
  }

  /* ── MAIN TEXT ── */
  .content {
    position: relative;
    z-index: 5;
    padding: 0 7vw;
    max-width: calc(var(--space-25) * 6.7);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(200, 168, 64, 0.5);
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
    opacity: 0;
    animation: slideInLeft 0.6s ease 0.2s forwards;
  }
  .eyebrow::before {
    content: '';
    display: block;
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(200, 168, 64, 0.5));
  }

  /* TYPEWRITER HEADLINE */
  .headline {
    font-family: 'Cormorant Garamond', serif;
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin-bottom: 32px;
  }
  .hl-line {
    display: block;
    overflow: hidden;
  }
  .hl-line-inner {
    display: block;
    line-height: 1.1;
    opacity: 0;
    transform: translateY(100%);
  }
  .hl-line:nth-child(1) .hl-line-inner {
    font-size: clamp(3.2rem, 6.5vw, 5.5rem);
    font-weight: 300;
    font-style: italic;
    color: rgba(232, 228, 240, 0.55);
    animation: lineRise 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
  }
  .hl-line:nth-child(2) .hl-line-inner {
    font-size: clamp(4.5rem, 9vw, 8rem);
    font-weight: 700;
    color: #f0ecf8;
    animation: lineRise 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.55s forwards;
  }
  .hl-line:nth-child(3) .hl-line-inner {
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 700;
    font-style: italic;
    animation: lineRise 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.7s forwards;
  }
  /* gold gradient on last line */
  .hl-gold {
    background: linear-gradient(100deg, #c8a840 0%, #f0d060 40%, #c8a840 80%);
    background-size: 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: goldShimmer 5s ease-in-out infinite;
  }
  @keyframes goldShimmer {
    0%,
    100% {
      background-position: 0%;
    }
    50% {
      background-position: 100%;
    }
  }

  @keyframes lineRise {
    from {
      opacity: 0;
      transform: translateY(100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* cursor blink in typewriter */
  .type-cursor {
    display: inline-block;
    width: 3px;
    height: 0.85em;
    background: #c8a840;
    vertical-align: middle;
    margin-left: 4px;
    animation: typeBlink 0.9s step-end infinite;
  }
  @keyframes typeBlink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .subtext {
    font-family: var(--font-secondary);
    font-size: clamp(0.9rem, 1.4vw, 1rem);
    line-height: var(--leading-relaxed);
    font-weight: var(--weight-light);
    color: rgba(200, 196, 220, 0.45);
    max-width: 420px;
    opacity: 0;
    animation: slideInLeft 0.7s ease 0.95s forwards;
  }

  /* bottom left meta */
  .meta-strip {
    position: absolute;
    bottom: var(--space-10);
    left: 7vw;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    opacity: 0;
    animation: fadeUp 0.5s ease 1.1s forwards;
  }
  .meta-item {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .meta-item .val {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    color: #c8a840;
    margin-bottom: 2px;
  }
  .meta-item .lbl {
    color: rgba(200, 196, 220, 0.3);
  }
  .meta-sep {
    width: 1px;
    height: 28px;
    background: rgba(200, 168, 64, 0.12);
  }

  /* right-edge label */
  .side-label {
    position: absolute;
    right: 28px;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    transform-origin: center;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(200, 168, 64, 0.2);
    z-index: 5;
    white-space: nowrap;
    opacity: 0;
    animation: fadeUp 0.5s ease 1.2s forwards;
  }

  /* horizontal rule */
  .h-rule {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(200, 168, 64, 0.12),
      transparent
    );
    z-index: 5;
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-24px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* LIGHT THEME */

  [data-theme='github-light'] {
    #cursor-ring {
      border-color: rgba(140, 90, 10, 0.35);
    }

    /* ── LIGHT THEME: amber spotlight → warm daylight wash ── */
    .spotlight {
      background: radial-gradient(
        ellipse at 30% 40%,
        rgba(200, 140, 40, 0.18) 0%,
        rgba(180, 120, 20, 0.08) 30%,
        transparent 70%
      );
    }

    /* ── LIGHT THEME: orbit ring borders ── */
    .orbit-ring::before {
      border-color: rgba(140, 90, 10, 0.12);
    }
    .orbits:hover .orbit-ring::before {
      border-color: rgba(140, 90, 10, 0.32);
    }

    /* ── LIGHT THEME: orbit labels ── */
    .orbit-label {
      color: rgba(140, 90, 10, 0.38);
    }
    .orbits:hover .orbit-ring .orbit-label {
      color: #8b5a0a;
    }

    /* ── LIGHT THEME: orbit center dot ── */
    .orbit-center-dot {
      background: #a07010;
      box-shadow:
        0 0 20px rgba(160, 112, 16, 0.5),
        0 0 60px rgba(160, 112, 16, 0.18);
    }

    /* ── LIGHT THEME: eyebrow ── */
    .eyebrow {
      color: rgba(140, 90, 10, 0.6);
    }
    .eyebrow::before {
      background: linear-gradient(90deg, transparent, rgba(140, 90, 10, 0.5));
    }

    /* ── LIGHT THEME: headline lines ── */
    .hl-line:nth-child(1) .hl-line-inner {
      color: rgba(26, 20, 8, 0.45);
    }
    .hl-line:nth-child(2) .hl-line-inner {
      color: #1a1408;
    }

    /* ── LIGHT THEME: gold gradient word (keep gold, slightly deeper) ── */
    .hl-gold {
      background: linear-gradient(100deg, #a07010 0%, #c89030 40%, #a07010 80%);
      background-size: 200%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* ── LIGHT THEME: typewriter cursor ── */
    .type-cursor {
      background: #a07010;
    }

    /* ── LIGHT THEME: subtext ── */
    .subtext {
      color: rgba(60, 50, 20, 0.5);
    }

    /* ── LIGHT THEME: meta strip ── */
    .meta-item .val {
      color: #a07010;
    }
    .meta-item .lbl {
      color: rgba(60, 50, 20, 0.38);
    }
    .meta-sep {
      background: rgba(140, 90, 10, 0.15);
    }

    /* ── LIGHT THEME: side label ── */
    .side-label {
      color: rgba(140, 90, 10, 0.25);
    }

    /* ── LIGHT THEME: bottom rule ── */
    .h-rule {
      background: linear-gradient(
        90deg,
        transparent,
        rgba(140, 90, 10, 0.15),
        transparent
      );
    }

    /* ── LIGHT THEME: theme toggle button ── */
    #theme-toggle {
      background: rgba(140, 90, 10, 0.08);
      border-color: rgba(140, 90, 10, 0.2);
      color: rgba(140, 90, 10, 0.7);
    }
  }
</style>

<script is:inline>
  /* ── ORBIT RINGS ── */
  const ORBIT_DATA = [
    {
      r: 0.42,
      spd: '38s',
      labels: [
        'Server Components',
        'Next.js 15',
        'React Patterns',
        'App Router',
      ],
    },
    {
      r: 0.58,
      spd: '52s',
      labels: [
        'TypeScript Generics',
        'Type Narrowing',
        'Utility Types',
        'Infer Magic',
        'Branded Types',
      ],
    },
    {
      r: 0.74,
      spd: '44s',
      labels: [
        'Node.js Event Loop',
        'Streams API',
        'Worker Threads',
        'Edge Functions',
        'Serverless',
      ],
    },
    {
      r: 0.88,
      spd: '62s',
      labels: [
        'CSS Container Queries',
        'View Transitions',
        'Cascade Layers',
        'Houdini API',
        'Subgrid',
        'Scroll Animations',
      ],
    },
  ];

  const orbitsEl = document.getElementById('orbits');
  const W = orbitsEl.offsetWidth;

  ORBIT_DATA.forEach(({ r, spd, labels }, ri) => {
    const ring = document.createElement('div');
    ring.className = 'orbit-ring';
    ring.style.setProperty('--spd', spd);
    ring.style.inset = `${(0.5 - r / 2) * 100}%`;

    labels.forEach((text, i) => {
      const angle = (i / labels.length) * 360;
      const label = document.createElement('span');
      label.className = 'orbit-label';
      label.textContent = text;
      label.style.setProperty('--spd', spd);

      // position at angle on the ring circumference
      const rad = (angle * Math.PI) / 180;
      const rx = (r / 2) * W;
      const lx = Math.cos(rad) * rx;
      const ly = Math.sin(rad) * rx;
      label.style.left = `calc(50% + ${lx}px)`;
      label.style.top = `calc(50% + ${ly}px)`;
      label.style.transform = `translate(-50%,-50%) rotate(${angle + 90}deg)`;
      // counter rotation applied via the animation below
      label.style.animation = `counterSpin ${spd} linear infinite`;
      if (ri % 2 === 1) label.style.animationDirection = 'reverse';

      ring.appendChild(label);
    });

    orbitsEl.insertBefore(ring, orbitsEl.querySelector('.orbit-center'));
  });

  /* pause orbit on hover of entire orbits area */
  orbitsEl.addEventListener('mouseenter', () => {
    document.querySelectorAll('.orbit-ring').forEach((r) => {
      r.style.animationPlayState = 'running'; // rings keep going
    });
  });
</script>
