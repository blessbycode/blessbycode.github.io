---

---

<section class="hero">
  <!-- Background layers -->
  <div class="hero-grid"></div>
  <div class="glow glow-1"></div>
  <div class="glow glow-2"></div>
  <div class="glow glow-3"></div>

  <!-- Floating tech chips -->
  <div class="tech-chips">
    <div class="t-chip">
      <div class="t-chip-dot" style="background:#61DAFB"></div>React
    </div>
    <div class="t-chip">
      <div class="t-chip-dot" style="background:#3B82F6"></div>TypeScript
    </div>
    <div class="t-chip">
      <div class="t-chip-dot" style="background:#68A063"></div>Node.js
    </div>
    <div class="t-chip">
      <div class="t-chip-dot" style="background:#FF7846"></div>Astro
    </div>
    <div class="t-chip">
      <div class="t-chip-dot" style="background:#FFD43B"></div>Python
    </div>
    <div class="t-chip">
      <div class="t-chip-dot" style="background:#4DB33D"></div>MongoDB
    </div>
    <div class="t-chip">
      <div class="t-chip-dot" style="background:#DD0031"></div>Angular
    </div>
    <div class="t-chip">
      <div class="t-chip-dot" style="background:#aaa"></div>Next.js
    </div>
    <div class="t-chip">
      <div class="t-chip-dot" style="background:#F7DF1E"></div>JavaScript
    </div>
    <div class="t-chip">
      <div class="t-chip-dot" style="background:#4A90D9"></div>CSS
    </div>
  </div>

  <!-- Main grid -->
  <div class="hero-content">
    <!-- ── LEFT ── -->
    <div class="hero-left">
      <div class="hero-eyebrow">
        <div class="eyebrow-pulse"></div>
        A developer's sanctuary
      </div>

      <h1 class="hero-logotype">blessbycode</h1>

      <p class="hero-tagline">
        Where every line of code<br />is a gift worth sharing.
      </p>

      <p class="hero-desc">
        Welcome to <strong>blessbycode</strong> — your go-to corner of the internet
        for
        <strong>real-world tutorials</strong>, honest deep-dives, and hard-won
        lessons across React, TypeScript, Node, Python, Astro and the entire
        modern web stack. No paywalls. No fluff. Just code that blesses.
      </p>

      <div class="hero-cta">
        <a href="/articles" class="btn-primary">
          Read articles
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
        <a href="/guides" class="btn-outline"> Browse guides </a>
      </div>
    </div>

    <!-- ── RIGHT ── -->
    <div class="hero-right">
      <!-- Orbit decoration -->
      <div class="orbit-wrap">
        <div class="orbit orbit-1"><div class="orbit-dot"></div></div>
        <div class="orbit orbit-2"></div>
        <div class="orbit orbit-3"><div class="orbit-dot"></div></div>
      </div>

      <!-- Main card -->
      <div class="card">
        <!-- Floating mini cards -->
        <div class="float-card float-card-1">
          <div class="fc-label">Latest post</div>
          <div class="fc-value">
            <div
              class="fc-dot"
              style="background:#61DAFB;box-shadow:0 0 calc(var(--space-2) + 2px) #61DAFB"
            >
            </div>
            RSC in Next.js 15
          </div>
        </div>
        <div class="float-card float-card-2">
          <div class="fc-label">New reader joined</div>
          <div class="fc-value">
            <div
              class="fc-dot"
              style="background:#22C55E;box-shadow:0 0 calc(var(--space-2) + 2px) #22C55E"
            >
            </div>
            just now 🎉
          </div>
        </div>

        <!-- Live code snippet -->
        <div class="card-snippet">
          <div class="snippet-bar">
            <div class="snippet-dot" style="background:#FF5F57"></div>
            <div class="snippet-dot" style="background:#FEBC2E"></div>
            <div class="snippet-dot" style="background:#28C840"></div>
            <span class="snippet-filename">welcome.ts</span>
            <span class="snippet-lang">TypeScript</span>
          </div>
          <div class="snippet-code">
            <p class="cm">// Welcome to blessbycode ✨</p>
            <span class="kw">const</span>
            <span class="fn">blessbycode</span> = &lcub; mission: <span
              class="str">"teach through real code"</span
            >, content: [<span class="str">"React"</span>, <span class="str"
              >"Node"</span
            >, <span class="str">"Python"</span>], price: <span class="num"
              >0</span
            >, <span class="cm">// always free 🎁</span>
            motto: <span class="str">"every line is a blessing"</span>, &rcub;

            <span class="fn">console</span>.<span class="fn">log</span>(<span
              class="str"
              >`You are
            </span><span class="op">${}welcome<span class="op"></span></span
            ><span class="str"> here`</span>)<span class="cursor"></span>
          </div>
        </div>

        <div class="card-tags">
          <span class="c-tag c-tag-react">React</span>
          <span class="c-tag c-tag-ts">TypeScript</span>
          <span class="c-tag c-tag-node">Node.js</span>
          <span class="c-tag c-tag-astro">Astro</span>
          <span class="c-tag c-tag-python">Python</span>
        </div>
      </div>

      <!-- Tech icons strip -->
      <div class="tech-row">
        <div
          class="tech-icon"
          style="color:#61DAFB;border-color:rgba(97,218,251,.25);background:rgba(97,218,251,.06)"
        >
          <svg
            width="18"
            height="18"
            viewBox="-11.5 -10.232 23 20.463"
            xmlns="http://www.w3.org/2000/svg"
            ><circle cx="0" cy="0" r="2.05" fill="#61DAFB"></circle><g
              stroke="#61DAFB"
              stroke-width="1"
              fill="none"
              ><ellipse rx="11" ry="4.2"></ellipse><ellipse
                rx="11"
                ry="4.2"
                transform="rotate(60)"></ellipse><ellipse
                rx="11"
                ry="4.2"
                transform="rotate(120)"></ellipse></g
            ></svg
          >
        </div>
        <div
          class="tech-icon"
          style="color:#3B82F6;border-color:rgba(59,130,246,.25);background:rgba(59,130,246,.06)"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 400 400"
            xmlns="http://www.w3.org/2000/svg"
            ><rect width="400" height="400" rx="60" fill="#3178C6"></rect><path
              d="M87.7 242L87.7 220L196 220L196 242L154 242L154 359L130 359L130 242Z"
              fill="white"></path><path
              d="M202 270C202 248 219 233 248 233C262 233 274 237 283 244L275 259C268 254 260 252 250 252C237 252 229 258 229 268C229 279 238 283 255 288C280 296 296 306 296 329C296 352 278 367 249 367C233 367 218 362 207 353L215 337C224 344 235 348 249 348C264 348 272 341 272 330C272 318 263 313 245 308C220 300 202 290 202 270Z"
              fill="white"></path></svg
          >
        </div>

        <div
          class="tech-icon"
          style="color:#68A063;border-color:rgba(104,160,99,.25);background:rgba(104,160,99,.06);font-weight:900;font-size:.9rem"
        >
          ⬡
        </div>
        <div
          class="tech-icon"
          style="color:#FFD43B;border-color:rgba(255,212,59,.25);background:rgba(255,212,59,.06);font-size:1rem"
        >
          🐍
        </div>
        <div
          class="tech-icon"
          style="color:#4DB33D;border-color:rgba(77,179,61,.25);background:rgba(77,179,61,.06);font-size:1rem"
        >
          🍃
        </div>
        <div
          class="tech-icon"
          style="color:#DD0031;border-color:rgba(221,0,49,.25);background:rgba(221,0,49,.06);font-weight:900;font-size:.9rem"
        >
          ▲
        </div>
        <div
          class="tech-icon"
          style="color:#aaa;border-color:rgba(170,170,170,.2);background:rgba(170,170,170,.05);font-weight:900;font-size:.85rem"
        >
          ▲
        </div>
      </div>
    </div><!-- /hero-right -->
  </div><!-- /hero-content -->
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: var(--space-16) var(--space-6) var(--space-16);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: var(--text-7xl) var(--text-7xl);
  }
  /* Fade the grid out near the centre */
  .hero-grid::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      var(--bg-base) 0%,
      transparent 100%
    );
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }
  .glow-1 {
    width: 680px;
    height: 680px;
    top: -140px;
    right: -120px;
    background: radial-gradient(circle, var(--glow-1) 0%, transparent 70%);
    animation: driftA 18s ease-in-out infinite alternate;
  }
  .glow-2 {
    width: 500px;
    height: 500px;
    bottom: -80px;
    left: -80px;
    background: radial-gradient(circle, var(--glow-2) 0%, transparent 70%);
    animation: driftB 22s ease-in-out infinite alternate;
  }
  .glow-3 {
    width: 400px;
    height: 400px;
    top: 40%;
    left: 40%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, var(--glow-3) 0%, transparent 70%);
    animation: driftC 14s ease-in-out infinite alternate;
  }
  @keyframes driftA {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(-40px, 30px) scale(1.08);
    }
  }
  @keyframes driftB {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(30px, -40px) scale(1.06);
    }
  }
  @keyframes driftC {
    from {
      transform: translate(-50%, -50%) scale(1);
    }
    to {
      transform: translate(-48%, -52%) scale(1.12);
    }
  }

  .tech-chips {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .t-chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(calc(var(--space-2) + 2px));
    border-radius: 50px;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    white-space: nowrap;
    animation: floatChip linear infinite;
    opacity: 0;
  }

  .t-chip-dot {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* positions & delays */
  .t-chip:nth-child(1) {
    top: 8%;
    left: 3%;
    animation-duration: 28s;
    animation-delay: 0s;
  }

  .t-chip:nth-child(2) {
    top: 15%;
    right: 5%;
    animation-duration: 24s;
    animation-delay: -6s;
  }

  .t-chip:nth-child(3) {
    top: 30%;
    left: 1%;
    animation-duration: 32s;
    animation-delay: -12s;
  }

  .t-chip:nth-child(4) {
    top: 25%;
    right: 2%;
    animation-duration: 26s;
    animation-delay: -4s;
  }

  .t-chip:nth-child(5) {
    bottom: 30%;
    left: 4%;
    animation-duration: 30s;
    animation-delay: -9s;
  }

  .t-chip:nth-child(6) {
    bottom: 20%;
    right: 4%;
    animation-duration: 22s;
    animation-delay: -15s;
  }

  .t-chip:nth-child(7) {
    top: 60%;
    left: 2%;
    animation-duration: 34s;
    animation-delay: -3s;
  }

  .t-chip:nth-child(8) {
    top: 55%;
    right: 3%;
    animation-duration: 28s;
    animation-delay: -18s;
  }

  .t-chip:nth-child(9) {
    bottom: 8%;
    left: 8%;
    animation-duration: 26s;
    animation-delay: -7s;
  }

  .t-chip:nth-child(10) {
    bottom: 12%;
    right: 8%;
    animation-duration: 20s;
    animation-delay: -11s;
  }

  @keyframes floatChip {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    8% {
      opacity: 0.7;
    }
    50% {
      opacity: 0.7;
      transform: translateY(-18px);
    }
    92% {
      opacity: 0.7;
    }
    100% {
      opacity: 0;
      transform: translateY(-36px);
    }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--space-16) - 4px);
    align-items: center;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-2) + 2px);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(12px);
    border-radius: 50px;
    padding: var(--space-2) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-7);
    width: fit-content;
    animation: slideUp 0.7s var(--ease-out) 0.1s both;
  }
  .eyebrow-pulse {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: 50%;
    background: var(--accent-primary);
    animation: pulse 2.4s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.65);
    }
  }

  .hero-logotype {
    font-family: var(--font-primary);
    font-size: clamp(3rem, 7vw, 5.8rem);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-3);
    animation: slideUp 0.7s var(--ease-out) 0.22s both;
    background: var(--grad-brand);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-tagline {
    font-family: var(--font-primary);
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-weight: var(--weight-regular);
    font-style: italic;
    color: var(--text-muted);
    margin-bottom: var(--space-7);
    line-height: var(--leading-snug);
    animation: slideUp 0.7s var(--ease-out) 0.32s both;
  }

  .hero-desc {
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 480px;
    margin-bottom: var(--space-10);
    animation: slideUp 0.7s var(--ease-out) 0.42s both;
  }
  .hero-desc strong {
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
  }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: calc(var(--space-3) + 2px);
    flex-wrap: wrap;
    margin-bottom: var(--space-13);
    animation: slideUp 0.7s var(--ease-out) 0.52s both;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(var(--space-7));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-right {
    position: relative;
    animation: scaleIn 0.8s var(--ease-spring) 0.4s both;
  }

  @keyframes scaleIn {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(var(--space-5));
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .orbit-wrap {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 440px;
    height: 440px;
    pointer-events: none;
  }

  .orbit {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px dashed var(--bg-border);
    animation: spinOrbit linear infinite;
  }

  .orbit-1 {
    animation-duration: 24s;
  }

  .orbit-2 {
    inset: var(--space-10);
    border-style: solid;
    border-color: transparent;
    border-top-color: var(--accent-primary);
    opacity: 0.3;
    animation-duration: 16s;
    animation-direction: reverse;
  }

  .orbit-3 {
    inset: var(--space-20);
    animation-duration: 32s;
    border-color: var(--bg-border);
  }

  @keyframes spinOrbit {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .orbit-dot {
    position: absolute;
    width: calc(var(--space-2) + 2px);
    height: calc(var(--space-2) + 2px);
    border-radius: 50%;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 12px currentColor;
  }

  .orbit-1 .orbit-dot {
    background: var(--accent-primary);
    color: var(--accent-primary);
  }

  .orbit-3 .orbit-dot {
    background: var(--accent-3);
    color: var(--accent-3);
    top: 50%;
    left: 100%;
  }

  .card {
    position: relative;
    z-index: 2;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(24px);
    border-radius: 28px;
    padding: 36px 32px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
    transition:
      background 0.35s,
      border-color 0.35s,
      box-shadow 0.35s;
  }

  [data-theme='light'] .card {
    box-shadow: 0 24px 64px rgba(15, 18, 32, 0.12);
  }

  .card-snippet {
    background: var(--bg-base);
    border: 1px solid var(--bg-border);
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 24px;
    transition:
      background 0.35s,
      border-color 0.35s;
  }

  .snippet-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: calc(var(--space-2) + 2px) var(--space-4);
    border-bottom: 1px solid var(--bg-border);
    background: var(--bg-elevated);
  }

  .snippet-dot {
    width: calc(var(--space-2) + 2px);
    height: calc(var(--space-2) + 2px);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .snippet-filename {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    margin-left: 4px;
    flex: 1;
    letter-spacing: 0.05em;
  }

  .snippet-lang {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--accent-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .snippet-code {
    padding: 18px 20px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--text-secondary);
    transition: color 0.35s;
  }

  .kw {
    color: var(--accent-primary);
  }

  .fn {
    color: var(--accent-secondary);
  }

  .str {
    color: var(--color-info);
  }

  .cm {
    color: var(--text-muted);
  }

  .op {
    color: var(--accent-tertiary);
  }

  .num {
    color: var(--color-warning);
  }

  .cursor {
    display: inline-block;
    width: 2px;
    height: 0.95em;
    background: var(--accent-primary);
    vertical-align: middle;
    margin-left: 2px;
    animation: blink 0.9s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .c-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: var(--space-1) var(--space-3);
    border-radius: 50px;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .c-tag-react {
    color: #61dafb;
    background: rgba(97, 218, 251, 0.1);
    border: 1px solid rgba(97, 218, 251, 0.25);
  }

  .c-tag-ts {
    color: #3b82f6;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.25);
  }

  .c-tag-astro {
    color: #ff7846;
    background: rgba(255, 120, 70, 0.1);
    border: 1px solid rgba(255, 120, 70, 0.25);
  }

  .c-tag-node {
    color: #68a063;
    background: rgba(104, 160, 99, 0.1);
    border: 1px solid rgba(104, 160, 99, 0.25);
  }

  .c-tag-python {
    color: #ffd43b;
    background: rgba(255, 212, 59, 0.1);
    border: 1px solid rgba(255, 212, 59, 0.25);
  }

  [data-theme='light'] .c-tag-python {
    color: #a16207;
    border-color: rgba(161, 98, 7, 0.25);
  }

  .float-card {
    position: absolute;
    z-index: 3;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(var(--space-4));
    border-radius: var(--space-4);
    padding: 12px var(--space-4);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
