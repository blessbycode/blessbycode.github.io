---

---

<section class="hero" id="hero">
  <!-- BG layer 1: circuit topology canvas -->
  <canvas id="circuitCanvas"></canvas>

  <!-- BG layer 2: depth planes -->
  <div class="depth-planes">
    <div class="dp"></div>
    <div class="dp"></div>
    <div class="dp"></div>
  </div>

  <!-- BG layer 3: scanline veil -->
  <div class="scanlines"></div>

  <!-- grain -->
  <div class="grain"></div>

  <!-- proximity glow (follows cursor) -->
  <div class="prox-glow"></div>

  <!-- corner brackets -->
  <div class="bracket tl"></div>
  <div class="bracket tr"></div>
  <div class="bracket bl"></div>
  <div class="bracket br"></div>

  <!-- orbit rings -->
  <div class="orbits" id="orbits">
    <div class="orbit-center"><div class="orbit-center-dot"></div></div>
  </div>

  <!-- side label -->
  <div class="side-label">blessbycode · courses</div>

  <!-- scroll cue -->
  <div class="scroll-cue">
    <div class="scroll-rail"></div>
    scroll
  </div>

  <!-- ── HERO BODY ── -->
  <div class="hero-body">
    <div class="col-divider"></div>

    <!-- LEFT -->
    <div class="hero-left">
      <div class="eyebrow">
        <div class="ey-dot"></div>
        Courses · blessbycode
      </div>

      <h1 class="headline">
        <span class="hl-line"><span class="hl-inner">learn the</span></span>
        <span class="hl-line"
          ><span class="hl-inner"
            ><span class="vivid">craft.</span><span class="type-cursor"
            ></span></span
          ></span
        >
        <span class="hl-line"><span class="hl-inner">build with it.</span></span
        >
      </h1>

      <p class="subtext">
        Deep-dive courses on the modern web stack — structured from fundamentals
        to advanced patterns, every step earned.
      </p>
    </div>

    <!-- RIGHT: 3D card stack -->
    <div class="hero-right">
      <div class="stack-scene">
        <div class="card-stack" id="cardStack">
          <!-- Card 1 – Angular -->
          <div class="ccard">
            <div class="ccard-head"></div>
            <div class="ccard-body">
              <div class="ccard-num">01 · Angular</div>
              <div class="ccard-title">Zero to Advanced</div>
              <div class="ccard-tags">
                <span class="ccard-tag">Signals</span>
                <span class="ccard-tag">NgRx</span>
                <span class="ccard-tag">SSR</span>
                <span class="ccard-tag">v21</span>
              </div>
              <div class="ccard-bar-wrap">
                <div class="ccard-bar" style="width:88%;--bar-delay:.5s"></div>
              </div>
            </div>
          </div>

          <!-- Card 2 – React -->
          <div class="ccard">
            <div class="ccard-head"></div>
            <div class="ccard-body">
              <div class="ccard-num">02 · React</div>
              <div class="ccard-title">Hooks to Production</div>
              <div class="ccard-tags">
                <span class="ccard-tag">Server Components</span>
                <span class="ccard-tag">Concurrency</span>
              </div>
              <div class="ccard-bar-wrap">
                <div class="ccard-bar" style="width:76%;--bar-delay:.6s"></div>
              </div>
            </div>
          </div>

          <!-- Card 3 – TypeScript -->
          <div class="ccard">
            <div class="ccard-head"></div>
            <div class="ccard-body">
              <div class="ccard-num">03 · TypeScript</div>
              <div class="ccard-title">Deep Dive</div>
              <div class="ccard-tags">
                <span class="ccard-tag">Generics</span>
                <span class="ccard-tag">Utility Types</span>
                <span class="ccard-tag">Zod</span>
              </div>
              <div class="ccard-bar-wrap">
                <div class="ccard-bar" style="width:92%;--bar-delay:.7s"></div>
              </div>
            </div>
          </div>

          <!-- Card 4 – Node.js -->
          <div class="ccard">
            <div class="ccard-head"></div>
            <div class="ccard-body">
              <div class="ccard-num">04 · Node.js</div>
              <div class="ccard-title">GraphQL &amp; APIs</div>
              <div class="ccard-tags">
                <span class="ccard-tag">REST</span>
                <span class="ccard-tag">Auth</span>
                <span class="ccard-tag">WebSockets</span>
              </div>
              <div class="ccard-bar-wrap">
                <div class="ccard-bar" style="width:68%;--bar-delay:.8s"></div>
              </div>
            </div>
          </div>

          <!-- Card 5 – Next.js -->
          <div class="ccard">
            <div class="ccard-head"></div>
            <div class="ccard-body">
              <div class="ccard-num">05 · Next.js 15</div>
              <div class="ccard-title">App Router</div>
              <div class="ccard-tags">
                <span class="ccard-tag">PPR</span>
                <span class="ccard-tag">Server Actions</span>
              </div>
              <div class="ccard-bar-wrap">
                <div class="ccard-bar" style="width:80%;--bar-delay:.9s"></div>
              </div>
            </div>
          </div>

          <!-- Card 6 – RxJS -->
          <div class="ccard">
            <div class="ccard-head"></div>
            <div class="ccard-body">
              <div class="ccard-num">06 · RxJS</div>
              <div class="ccard-title">Reactive Patterns</div>
              <div class="ccard-tags">
                <span class="ccard-tag">Operators</span>
                <span class="ccard-tag">Subjects</span>
              </div>
              <div class="ccard-bar-wrap">
                <div class="ccard-bar" style="width:62%;--bar-delay:1s"></div>
              </div>
            </div>
          </div>
        </div><!-- /card-stack -->
        <div class="stack-hint">hover to explore</div>
      </div><!-- /stack-scene -->
    </div>
  </div>

  <style is:inline>
    [data-theme='github-dark-dimmed'] {
      --brk-clr: rgba(0, 229, 204, 0.16);
      --orb-clr: rgba(0, 229, 204, 0.08);
      --orb-acc: rgba(168, 85, 247, 0.08);
      /* circuit line colors */
      --cir-base: rgba(0, 229, 204, 0.055);
      --cir-node: rgba(0, 229, 204, 0.18);
      --cir-pulse: 0, 229, 204;
      --cir-accent: 168, 85, 247;
      /* proximity glow */
      --prox-color: rgba(0, 229, 204, 0.035);
      --prox-accent: rgba(168, 85, 247, 0.025);
    }

    [data-theme='github-light'] {
      --brk-clr: rgba(124, 58, 237, 0.18);
      --orb-clr: rgba(124, 58, 237, 0.07);
      --orb-acc: rgba(236, 72, 153, 0.07);
      --cir-base: rgba(124, 58, 237, 0.05);
      --cir-node: rgba(124, 58, 237, 0.16);
      --cir-pulse: 124, 58, 237;
      --cir-accent: 236, 72, 153;
      --prox-color: rgba(124, 58, 237, 0.03);
      --prox-accent: rgba(236, 72, 153, 0.022);
    }

    /* ══════════════════════════════════════════════════
   HERO
══════════════════════════════════════════════════ */
    .hero {
      position: relative;
      width: 100%;
      height: calc(100vh - 80px);
      display: grid;
      grid-template-rows: auto 1fr;
      overflow: hidden;
      background: var(--bg-canvas);
      transition: background var(--transition-slow);
    }

    /* Layer 1 — circuit canvas */
    #circuitCanvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
    }

    /* Layer 2 — depth planes */
    .depth-planes {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      overflow: hidden;
    }
    .dp {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      will-change: transform;
    }
    .dp:nth-child(1) {
      width: 80vw;
      height: 70vh;
      top: -20%;
      left: -15%;
      background: radial-gradient(
        ellipse,
        var(--prox-color) 0%,
        transparent 60%
      );
      animation: dpDrift1 24s ease-in-out infinite;
    }
    .dp:nth-child(2) {
      width: 65vw;
      height: 75vh;
      bottom: -25%;
      right: -18%;
      background: radial-gradient(
        ellipse,
        var(--prox-accent) 0%,
        transparent 60%
      );
      animation: dpDrift2 30s ease-in-out infinite;
    }
    .dp:nth-child(3) {
      width: 50vw;
      height: 50vh;
      top: 25%;
      left: 25%;
      background: radial-gradient(
        ellipse,
        var(--prox-color) 0%,
        transparent 55%
      );
      opacity: 0.6;
      animation: dpDrift3 20s ease-in-out infinite;
    }
    @keyframes dpDrift1 {
      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }
      50% {
        transform: translate(6vw, 8vh) scale(1.06);
      }
    }
    @keyframes dpDrift2 {
      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }
      40% {
        transform: translate(-8vw, -6vh) scale(1.08);
      }
      70% {
        transform: translate(4vw, 3vh) scale(0.96);
      }
    }
    @keyframes dpDrift3 {
      0%,
      100% {
        transform: translate(0, 0) scale(1) rotate(0deg);
      }
      50% {
        transform: translate(-5vw, 6vh) scale(1.1) rotate(8deg);
      }
    }

    /* Layer 3 — scanline veil */
    .scanlines {
      position: absolute;
      inset: 0;
      z-index: 3;
      pointer-events: none;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(255, 255, 255, 0.008) 2px,
        rgba(255, 255, 255, 0.008) 3px
      );
    }
    [data-theme='github-light'] .scanlines {
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.005) 2px,
        rgba(0, 0, 0, 0.005) 3px
      );
    }

    /* grain */
    .grain {
      position: absolute;
      inset: 0;
      z-index: 4;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-size: 160px;
      opacity: 0.038;
    }
    [data-theme='github-light'] .grain {
      opacity: 0.025;
    }

    /* ── HOVER PROXIMITY GLOW ──
   A soft radial follows the cursor via CSS vars --mx/--my
   set in JS. Fades in only when mouse is inside hero.      */
    .prox-glow {
      position: absolute;
      inset: 0;
      z-index: 5;
      pointer-events: none;
      background: radial-gradient(
        700px circle at var(--mx, 50%) var(--my, 120%),
        rgba(var(--cir-pulse), 0.06) 0%,
        rgba(var(--cir-accent), 0.03) 40%,
        transparent 68%
      );
      opacity: 0;
      transition: opacity 0.5s ease;
    }
    .hero:hover .prox-glow {
      opacity: 1;
    }

    /* ── CORNER BRACKETS ── */
    .bracket {
      position: absolute;
      z-index: 9;
      pointer-events: none;
      width: 20px;
      height: 20px;
      border-color: var(--brk-clr);
      border-style: solid;
      border-width: 0;
      transition:
        border-color 0.4s ease,
        width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
        height 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 0.4s ease;
    }
    .bracket.tl {
      top: 66px;
      left: clamp(20px, 5vw, 60px);
      border-top-width: 1px;
      border-left-width: 1px;
    }
    .bracket.tr {
      top: 66px;
      right: clamp(20px, 5vw, 60px);
      border-top-width: 1px;
      border-right-width: 1px;
    }
    .bracket.bl {
      bottom: 36px;
      left: clamp(20px, 5vw, 60px);
      border-bottom-width: 1px;
      border-left-width: 1px;
    }
    .bracket.br {
      bottom: 36px;
      right: clamp(20px, 5vw, 60px);
      border-bottom-width: 1px;
      border-right-width: 1px;
    }
    .hero:hover .bracket {
      width: 30px;
      height: 30px;
      border-color: var(--accent-primary);
      opacity: 0.55;
    }

    /* ── ORBIT RINGS ── */
    .orbits {
      position: absolute;
      right: -8vw;
      top: 50%;
      transform: translateY(-50%);
      width: min(62vh, 580px);
      height: min(62vh, 580px);
      z-index: 5;
      pointer-events: none;
    }
    .orbit-ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: orbitSpin var(--spd, 36s) linear infinite;
    }
    .orbit-ring::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 1px solid var(--orb-clr);
      pointer-events: none;
      transition: border-color 0.5s ease;
    }
    .orbit-ring:nth-child(even) {
      animation-direction: reverse;
    }
    .orbit-ring:nth-child(even)::before {
      border-color: var(--orb-acc);
    }
    @keyframes orbitSpin {
      from {
        transform: rotate(0);
      }
      to {
        transform: rotate(360deg);
      }
    }

    .orbit-label {
      position: absolute;
      font-family: var(--font-secondary);
      font-size: clamp(0.44rem, 0.52vw, 0.56rem);
      letter-spacing: 0.1em;
      white-space: nowrap;
      color: var(--text-muted);
      animation: counterSpin var(--spd, 36s) linear infinite;
      transition:
        color 0.4s ease,
        opacity 0.4s ease;
    }
    .orbit-ring:nth-child(even) .orbit-label {
      animation-direction: reverse;
    }
    @keyframes counterSpin {
      from {
        transform: rotate(0);
      }
      to {
        transform: rotate(-360deg);
      }
    }

    /* hover: rings brighten, labels appear */
    .hero:hover .orbit-ring::before {
      border-color: rgba(var(--cir-pulse), 0.2);
    }
    .hero:hover .orbit-ring:nth-child(even)::before {
      border-color: rgba(var(--cir-accent), 0.18);
    }
    .hero:hover .orbit-label {
      color: var(--text-tertiary);
    }

    .orbit-center {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
    }
    .orbit-center-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent-primary);
      box-shadow: var(--shadow-glow);
      animation: dotPulse 3.2s ease-in-out infinite;
    }
    @keyframes dotPulse {
      0%,
      100% {
        transform: scale(1);
        opacity: 0.8;
      }
      50% {
        transform: scale(1.7);
        opacity: 0.35;
      }
    }

    .hero-body {
      position: relative;
      z-index: 6;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 80px clamp(20px, 5vw, 60px);
    }

    .col-divider {
      position: absolute;
      top: 8%;
      bottom: 8%;
      left: 50%;
      width: 1px;
      background: linear-gradient(
        to bottom,
        transparent,
        var(--bg-border),
        transparent
      );
      z-index: 7;
      pointer-events: none;
      transition: background var(--transition-slow);
    }
    /* divider brightens on hero hover */
    .hero:hover .col-divider {
      background: linear-gradient(
        to bottom,
        transparent,
        rgba(var(--cir-pulse), 0.18),
        transparent
      );
    }

    /* ── LEFT COLUMN ── */
    .hero-left {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      padding-right: clamp(20px, 4vw, 56px);
    }

    .eyebrow {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: var(--space-3);
      opacity: 0;
      animation: slideLeft 0.6s ease 0.15s forwards;
      transition: color var(--transition-slow);
    }
    .eyebrow::before {
      content: '';
      display: block;
      width: var(--space-9);
      height: 1px;
      flex-shrink: 0;
      background: linear-gradient(90deg, transparent, var(--accent-primary));
      transition: background var(--transition-slow);
    }
    .ey-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      flex-shrink: 0;
      background: var(--accent-primary);
      box-shadow: var(--shadow-glow);
      animation: eyDot 2.4s ease-in-out infinite;
    }
    @keyframes eyDot {
      0%,
      100% {
        transform: scale(1);
        opacity: 1;
      }
      50% {
        transform: scale(1.8);
        opacity: 0.35;
      }
    }

    .hl-line {
      display: block;
      overflow: hidden;
    }
    .hl-inner {
      display: block;
      opacity: 0;
      transform: translateY(100%);
    }
    .hl-line:nth-child(1) .hl-inner {
      font-size: clamp(2rem, 3.8vw, 3.4rem);
      font-weight: var(--weight-light);
      font-style: italic;
      color: var(--text-tertiary);
      animation: lineRise 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    }
    .hl-line:nth-child(2) .hl-inner {
      font-size: clamp(4.5rem, 8.5vw, 7.8rem);
      font-weight: var(--weight-black);
      color: var(--text-primary);
      animation: lineRise 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.44s forwards;
    }
    .hl-line:nth-child(3) .hl-inner {
      font-size: clamp(2rem, 3.8vw, 3.4rem);
      font-weight: var(--weight-light);
      font-style: italic;
      color: var(--text-tertiary);
      animation: lineRise 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.58s forwards;
    }
    @keyframes lineRise {
      from {
        opacity: 0;
        transform: translateY(100%);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .vivid {
      background: var(--grad-brand);
      background-size: 200%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: vividShift 5s ease-in-out infinite;
    }
    @keyframes vividShift {
      0%,
      100% {
        background-position: 0%;
      }
      50% {
        background-position: 100%;
      }
    }

    .type-cursor {
      display: inline-block;
      width: 3px;
      height: 0.85em;
      background: var(--accent-primary);
      vertical-align: middle;
      margin-left: 4px;
      animation: typeBlink 0.9s step-end infinite;
      transition: background var(--transition-slow);
    }
    @keyframes typeBlink {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0;
      }
    }

    /* hover: headline lines shift up subtly */
    .hero:hover .hl-line:nth-child(1) .hl-inner {
      transform: translateY(-2px);
      transition: transform 0.5s ease;
    }
    .hero:hover .hl-line:nth-child(3) .hl-inner {
      transform: translateY(2px);
      transition: transform 0.5s ease;
    }

    .subtext {
      font-family: var(--font-secondary);
      font-size: clamp(0.84rem, 1.25vw, 0.96rem);
      line-height: 1.76;
      font-weight: var(--weight-light);
      color: var(--text-tertiary);
      max-width: 400px;
      opacity: 0;
      animation: slideLeft 0.6s ease 0.75s forwards;
      transition: color var(--transition-slow);
    }

    /* ── RIGHT COLUMN ── */
    .hero-right {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      padding-left: clamp(16px, 3vw, 40px);
      height: 100%;
    }

    /* ══════════════════════════════════════
   CARD STACK — 3D perspective fan
   6 cards stacked with perspective depth.
   At rest: collapsed stack, each card
   peeking above the one in front.
   On .stack:hover: fans open like a hand
   of cards — each slides to its own
   position with spring easing.
   Individual card:hover lifts forward
   out of the plane (translateZ + scale).
══════════════════════════════════════ */
    .stack-scene {
      perspective: 900px;
      perspective-origin: 50% 45%;
      width: 100%;
      max-width: 360px;
      /* extra room for fanned cards to overflow */
      height: 340px;
      position: relative;
      opacity: 0;
      animation: riseIn 0.7s ease 0.45s forwards;
    }

    .card-stack {
      position: absolute;
      inset: 0;
      transform-style: preserve-3d;
    }

    /* each .ccard sits absolutely, centred */
    .ccard {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 300px;
      transform: translate(-50%, -50%) rotateX(var(--rx, 0deg))
        rotateY(var(--ry, 0deg)) translateZ(var(--tz, 0px))
        translateY(var(--ty, 0px)) scale(var(--sc, 1));
      transform-origin: center center;
      transition:
        transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 0.4s ease,
        border-color 0.3s ease;

      border-radius: 10px;
      border: 1px solid var(--bg-border);
      background: var(--card-bg, var(--bg-elevated));
      box-shadow:
        0 2px 8px rgba(0, 0, 0, 0.25),
        0 1px 2px rgba(0, 0, 0, 0.15);
      overflow: hidden;
      cursor: default;
      will-change: transform;
    }

    /* collapsed at-rest stack — cards peek above each other */
    .ccard:nth-child(1) {
      --ty: 0px;
      --tz: 0px;
      --rx: 0deg;
      --ry: 0deg;
      --sc: 1;
      z-index: 6;
    }
    .ccard:nth-child(2) {
      --ty: 10px;
      --tz: -18px;
      --rx: 2deg;
      --ry: 0deg;
      --sc: 0.97;
      z-index: 5;
    }
    .ccard:nth-child(3) {
      --ty: 20px;
      --tz: -36px;
      --rx: 4deg;
      --ry: 0deg;
      --sc: 0.94;
      z-index: 4;
    }
    .ccard:nth-child(4) {
      --ty: 30px;
      --tz: -54px;
      --rx: 6deg;
      --ry: 0deg;
      --sc: 0.91;
      z-index: 3;
    }
    .ccard:nth-child(5) {
      --ty: 40px;
      --tz: -72px;
      --rx: 8deg;
      --ry: 0deg;
      --sc: 0.88;
      z-index: 2;
    }
    .ccard:nth-child(6) {
      --ty: 50px;
      --tz: -90px;
      --rx: 10deg;
      --ry: 0deg;
      --sc: 0.85;
      z-index: 1;
    }

    /* FANNED — stack:hover spreads the deck */
    .card-stack:hover .ccard:nth-child(1) {
      --ty: -92px;
      --tz: 60px;
      --rx: -6deg;
      --ry: -8deg;
      --sc: 1.02;
    }
    .card-stack:hover .ccard:nth-child(2) {
      --ty: -44px;
      --tz: 30px;
      --rx: -2deg;
      --ry: -3deg;
      --sc: 0.99;
    }
    .card-stack:hover .ccard:nth-child(3) {
      --ty: 6px;
      --tz: 0px;
      --rx: 2deg;
      --ry: 2deg;
      --sc: 0.97;
    }
    .card-stack:hover .ccard:nth-child(4) {
      --ty: 58px;
      --tz: -30px;
      --rx: 6deg;
      --ry: 7deg;
      --sc: 0.94;
    }
    .card-stack:hover .ccard:nth-child(5) {
      --ty: 110px;
      --tz: -60px;
      --rx: 10deg;
      --ry: 12deg;
      --sc: 0.91;
    }
    .card-stack:hover .ccard:nth-child(6) {
      --ty: 162px;
      --tz: -90px;
      --rx: 14deg;
      --ry: 17deg;
      --sc: 0.88;
    }

    /* individual card lift on its own hover (overrides stack fan) */
    .ccard:hover {
      --tz: 80px !important;
      --sc: 1.05 !important;
      --rx: -4deg !important;
      --ry: 0deg !important;
      box-shadow:
        0 20px 50px rgba(0, 0, 0, 0.45),
        0 6px 18px rgba(0, 0, 0, 0.3),
        0 0 0 1px rgba(var(--card-rgb), 0.35);
      border-color: rgba(var(--card-rgb), 0.4);
      z-index: 10 !important;
    }

    /* card internal layout */
    .ccard-head {
      height: 5px;
      background: linear-gradient(
        90deg,
        rgba(var(--card-rgb), 0.9) 0%,
        rgba(var(--card-rgb), 0.5) 60%,
        transparent 100%
      );
    }
    .ccard-body {
      padding: 16px 18px 14px;
    }
    .ccard-num {
      font-family: var(--font-secondary);
      font-size: 0.5rem;
      font-weight: var(--weight-medium);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(var(--card-rgb), 1);
      margin-bottom: 7px;
      opacity: 0.8;
    }
    .ccard-title {
      font-family: var(--font-primary);
      font-size: var(--text-lg);
      font-weight: var(--weight-bold);
      line-height: var(--leading-tight);
      letter-spacing: -0.01em;
      color: var(--text-primary);
      margin-bottom: 10px;
      transition: color var(--transition-slow);
    }
    .ccard-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-bottom: 12px;
    }
    .ccard-tag {
      font-family: var(--font-secondary);
      font-size: 0.44rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 2px 7px;
      border-radius: 3px;
      background: rgba(var(--card-rgb), 0.1);
      border: 1px solid rgba(var(--card-rgb), 0.2);
      color: rgba(var(--card-rgb), 1);
      opacity: 0.85;
    }
    .ccard-bar-wrap {
      height: 2px;
      background: rgba(var(--card-rgb), 0.12);
      border-radius: 99px;
      overflow: hidden;
    }
    .ccard-bar {
      height: 100%;
      border-radius: 99px;
      background: linear-gradient(
        90deg,
        rgba(var(--card-rgb), 1),
        rgba(var(--card-rgb), 0.5)
      );
      transform-origin: left;
      animation: barGrow 1s cubic-bezier(0.16, 1, 0.3, 1) var(--bar-delay, 0.5s)
        both;
    }
    @keyframes barGrow {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }

    /* card colour theming via --card-rgb */
    [data-theme='github-dark-dimmed'] {
      --c1: 0, 229, 204; /* teal   – Angular */
      --c2: 0, 153, 255; /* blue   – React   */
      --c3: 168, 85, 247; /* violet – TS      */
      --c4: 249, 115, 22; /* orange – Node    */
      --c5: 34, 197, 94; /* green  – Next    */
      --c6: 236, 72, 153; /* pink   – RxJS    */
    }
    [data-theme='github-light'] {
      --c1: 7, 181, 160;
      --c2: 37, 99, 235;
      --c3: 109, 40, 217;
      --c4: 194, 65, 12;
      --c5: 22, 163, 74;
      --c6: 190, 24, 93;
    }
    .ccard:nth-child(1) {
      --card-rgb: var(--c1);
    }
    .ccard:nth-child(2) {
      --card-rgb: var(--c2);
    }
    .ccard:nth-child(3) {
      --card-rgb: var(--c3);
    }
    .ccard:nth-child(4) {
      --card-rgb: var(--c4);
    }
    .ccard:nth-child(5) {
      --card-rgb: var(--c5);
    }
    .ccard:nth-child(6) {
      --card-rgb: var(--c6);
    }

    /* hint text below stack */
    .stack-hint {
      position: absolute;
      bottom: -28px;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-secondary);
      font-size: 0.46rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text-muted);
      white-space: nowrap;
      transition: color var(--transition-slow);
      pointer-events: none;
      opacity: 0;
      animation: riseIn 0.5s ease 1.1s forwards;
    }
    [data-theme='github-dark-dimmed'] .ccard {
      background: #10131c;
    }
    [data-theme='github-light'] .ccard {
      background: #f8f9fd;
    }

    /* ── SIDE LABEL ── */
    .side-label {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%) rotate(90deg);
      font-family: var(--font-secondary);
      font-size: 0.46rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--text-muted);
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      animation: riseIn 0.5s ease 1.1s forwards;
      transition: color var(--transition-slow);
    }

    /* ── SCROLL CUE ── */
    .scroll-cue {
      position: absolute;
      bottom: 22px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 9;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      font-family: var(--font-secondary);
      font-size: 0.48rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text-muted);
      opacity: 0;
      animation: riseIn 0.5s ease 1.2s forwards;
      pointer-events: none;
      transition: color var(--transition-slow);
    }
    .scroll-rail {
      width: 1px;
      height: 26px;
      background: var(--bg-border);
      position: relative;
      overflow: hidden;
      border-radius: 99px;
      transition: background var(--transition-slow);
    }
    .scroll-rail::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 55%;
      background: linear-gradient(
        to bottom,
        var(--accent-primary),
        transparent
      );
      border-radius: 99px;
      animation: railDrop 2s ease-in-out infinite;
    }
    @keyframes railDrop {
      0% {
        transform: translateY(-100%);
        opacity: 1;
      }
      80% {
        opacity: 1;
      }
      100% {
        transform: translateY(220%);
        opacity: 0;
      }
    }

    /* ══════════════════════════════════════════════════
   ENTRY ANIMATIONS
══════════════════════════════════════════════════ */
    @keyframes riseIn {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes slideLeft {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    /* ══════════════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════════════ */
    @media (max-width: 860px) {
      .hero-body {
        grid-template-columns: 1fr;
      }
      .hero-right,
      .col-divider,
      .side-label,
      .orbits {
        display: none;
      }
    }
    @media (max-width: 520px) {
      .hl-line:nth-child(2) .hl-inner {
        font-size: 3.4rem;
      }
      .bracket {
        display: none;
      }
    }
  </style>

  <script is:inline>
    (function () {
      const hero = document.getElementById('hero');
      let tx = 50,
        ty = 50,
        cx = 50,
        cy = 50,
        raf = null;
      hero.addEventListener('mousemove', function (e) {
        const r = hero.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width) * 100;
        ty = ((e.clientY - r.top) / r.height) * 100;
        if (!raf) raf = requestAnimationFrame(tick);
      });
      function tick() {
        cx += (tx - cx) * 0.07;
        cy += (ty - cy) * 0.07;
        hero.style.setProperty('--mx', cx.toFixed(2) + '%');
        hero.style.setProperty('--my', cy.toFixed(2) + '%');
        if (Math.abs(tx - cx) > 0.04 || Math.abs(ty - cy) > 0.04)
          raf = requestAnimationFrame(tick);
        else raf = null;
      }
    })();

    /* ════════════════════════════════════════
   CIRCUIT TOPOLOGY CANVAS
   ─────────────────────────────────────
   Concept: PCB-style routing.
   • ~40 nodes placed via a seeded jitter grid
   • Each node connects to 2–4 nearest neighbours
   • Edges are drawn as orthogonal (L-shaped) traces:
       horizontal segment → corner dot → vertical segment
   • Energy "pulses" — small bright dots — travel
     continuously along each edge in one direction
   • Mouse proximity: nodes within 180px are magnetically
     pulled ≤22px toward cursor; their connected traces
     stretch with them (live recalc every frame)
   • Click: a radial shock-wave travels outward; any
     pulse on an edge touched by the wave briefly
     flares to full brightness
════════════════════════════════════════ */
    (function () {
      const cv = document.getElementById('circuitCanvas');
      const ctx = cv.getContext('2d');
      const hero = document.getElementById('hero');
      let W, H;
      const mouse = { x: -9999, y: -9999, inside: false };
      const bursts = []; // {x,y,born,maxAge}

      /* ── node layout ── */
      const COLS = 10,
        ROWS = 7,
        JITTER = 0.38;
      let nodes = [],
        edges = [];

      function seed(x) {
        let s = (x * 2654435761) | 0;
        s ^= s >> 16;
        s *= 0x45d9f3b;
        s ^= s >> 16;
        return (s >>> 0) / 0xffffffff;
      }

      function buildGraph() {
        nodes = [];
        const cw = W / COLS,
          ch = H / ROWS;
        for (let r = 0; r < ROWS; r++)
          for (let c = 0; c < COLS; c++) {
            const i = r * COLS + c;
            nodes.push({
              bx: (c + 0.5) * cw + (seed(i * 7 + 1) - 0.5) * cw * JITTER,
              by: (r + 0.5) * ch + (seed(i * 7 + 3) - 0.5) * ch * JITTER,
              x: 0,
              y: 0, // displaced by mouse
              pulseOffset: seed(i * 7 + 5), // stagger
            });
          }
        // build edges: each node connects to 2–3 nearest
        edges = [];
        const added = new Set();
        nodes.forEach((n, i) => {
          const dists = nodes
            .map((m, j) => ({ j, d: Math.hypot(m.bx - n.bx, m.by - n.by) }))
            .filter(({ j, d }) => j !== i && d < Math.max(W, H) * 0.25)
            .sort((a, b) => a.d - b.d)
            .slice(0, 3);
          dists.forEach(({ j }) => {
            const key = Math.min(i, j) + '-' + Math.max(i, j);
            if (!added.has(key)) {
              added.add(key);
              edges.push({
                a: i,
                b: j,
                t: seed(i * 31 + j * 17), // pulse position 0–1
                speed: 0.0008 + seed(i + j * 3) * 0.0006,
                flare: 0,
              });
            }
          });
        });
      }

      function resize() {
        W = cv.width = cv.offsetWidth;
        H = cv.height = cv.offsetHeight;
        buildGraph();
      }
      new ResizeObserver(resize).observe(hero);
      resize();

      hero.addEventListener('mousemove', (e) => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
        mouse.inside = true;
      });
      hero.addEventListener('mouseleave', () => {
        mouse.inside = false;
      });
      document.addEventListener('click', (e) => {
        const r = hero.getBoundingClientRect();
        if (
          e.clientX >= r.left &&
          e.clientX <= r.right &&
          e.clientY >= r.top &&
          e.clientY <= r.bottom
        )
          bursts.push({
            x: e.clientX,
            y: e.clientY,
            born: performance.now(),
            maxAge: 1400,
          });
      });

      function isDark() {
        return (
          document.documentElement.getAttribute('data-theme') !== 'github-light'
        );
      }

      function lerp(a, b, t) {
        return a + (b - a) * t;
      }

      let lastT = performance.now();

      function draw() {
        requestAnimationFrame(draw);
        const now = performance.now();
        const dt = Math.min(now - lastT, 32);
        lastT = now;

        ctx.clearRect(0, 0, W, H);

        const dark = isDark();
        const [pr, pg, pb] = dark ? [0, 229, 204] : [124, 58, 237];
        const [ar, ag, ab] = dark ? [168, 85, 247] : [236, 72, 153];

        // cull bursts
        for (let i = bursts.length - 1; i >= 0; i--)
          if (now - bursts[i].born > bursts[i].maxAge) bursts.splice(i, 1);

        /* ── displace nodes toward mouse ── */
        const PULL_R = 180,
          PULL_MAX = 22;
        nodes.forEach((n) => {
          let dx = 0,
            dy = 0;
          if (mouse.inside) {
            const dist = Math.hypot(n.bx - mouse.x, n.by - mouse.y);
            if (dist < PULL_R) {
              const s = 1 - dist / PULL_R;
              dx = ((mouse.x - n.bx) * s * PULL_MAX) / Math.max(dist, 1);
              dy = ((mouse.y - n.by) * s * PULL_MAX) / Math.max(dist, 1);
            }
          }
          n.x = n.bx + dx;
          n.y = n.by + dy;
        });

        /* ── advance pulses ── */
        edges.forEach((e) => {
          e.t = (e.t + e.speed * dt) % 1;
          e.flare = Math.max(0, e.flare - 0.004 * dt);
        });

        /* ── burst flare: pulses near shockwave front ── */
        bursts.forEach((b) => {
          const age = (now - b.born) / b.maxAge;
          const front = age * Math.max(W, H) * 1.2;
          edges.forEach((e) => {
            const na = nodes[e.a],
              nb = nodes[e.b];
            // midpoint of edge
            const mx = (na.x + nb.x) / 2,
              my = (na.y + nb.y) / 2;
            const d = Math.hypot(mx - b.x, my - b.y);
            const diff = Math.abs(d - front);
            if (diff < 50)
              e.flare = Math.max(e.flare, (1 - diff / 50) * (1 - age) * 1.5);
          });
        });

        /* ── draw edges as orthogonal traces ── */
        edges.forEach((e) => {
          const na = nodes[e.a],
            nb = nodes[e.b];
          const ax = na.x,
            ay = na.y,
            bx = nb.x,
            by = nb.y;
          const corner = { x: bx, y: ay }; // horizontal first, then vertical
          const baseA = dark ? 0.055 : 0.048;
          const lineA = baseA + e.flare * 0.28;

          // mouse proximity boost on this edge
          const edgeMidX = (ax + bx) / 2,
            edgeMidY = (ay + by) / 2;
          const mDist = Math.hypot(edgeMidX - mouse.x, edgeMidY - mouse.y);
          const mBoost = mouse.inside
            ? Math.max(0, (1 - mDist / 250) * 0.18)
            : 0;
          const totalA = lineA + mBoost;

          // pick colour: alternate primary / accent per edge index
          const useAccent = (e.a + e.b) % 3 === 0;
          const [r, g, b2] = useAccent ? [ar, ag, ab] : [pr, pg, pb];

          ctx.strokeStyle = `rgba(${r},${g},${b2},${totalA})`;
          ctx.lineWidth = 0.9;
          ctx.beginPath();
          ctx.moveTo(ax, ay);
          ctx.lineTo(corner.x, corner.y);
          ctx.lineTo(bx, by);
          ctx.stroke();

          // corner dot
          ctx.beginPath();
          ctx.arc(corner.x, corner.y, 1.8, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${r},${g},${b2},${totalA * 1.4})`;
          ctx.fill();

          /* pulse dot */
          const t2 = e.t;
          let px, py;
          const halfLen = (Math.abs(bx - ax) + Math.abs(by - ay)) * 0.5;
          const hLen =
            Math.abs(bx - ax) / (Math.abs(bx - ax) + Math.abs(by - ay) || 1);
          if (t2 < hLen) {
            const s = t2 / hLen;
            px = lerp(ax, corner.x, s);
            py = ay;
          } else {
            const s = (t2 - hLen) / (1 - hLen || 0.001);
            px = corner.x;
            py = lerp(corner.y, by, s);
          }
          const pulseA = 0.5 + e.flare * 0.5 + mBoost * 2;
          const pulseR = 1.8 + e.flare * 2.5;
          ctx.beginPath();
          ctx.arc(px, py, pulseR, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${r},${g},${b2},${pulseA})`;
          if (e.flare > 0.3 || mBoost > 0.08) {
            ctx.shadowBlur = 8 + e.flare * 12;
            ctx.shadowColor = `rgba(${r},${g},${b2},.7)`;
          }
          ctx.fill();
          ctx.shadowBlur = 0;
        });

        /* ── draw nodes ── */
        nodes.forEach((n, i) => {
          const mDist = Math.hypot(n.x - mouse.x, n.y - mouse.y);
          const inf = mouse.inside ? Math.max(0, 1 - mDist / 180) : 0;
          const a = dark ? 0.07 + inf * 0.35 : 0.06 + inf * 0.3;
          const r2 = 1.5 + inf * 2.5;
          ctx.beginPath();
          ctx.arc(n.x, n.y, r2, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${pr},${pg},${pb},${a})`;
          if (inf > 0.5) {
            ctx.shadowBlur = 6;
            ctx.shadowColor = `rgba(${pr},${pg},${pb},.5)`;
          }
          ctx.fill();
          ctx.shadowBlur = 0;
        });
      }
      draw();
    })();

    /* ════════════════════════════════════════
   CARD STACK — mouse-tilt on hovered card
════════════════════════════════════════ */
    (function () {
      document.querySelectorAll('.ccard').forEach(function (card) {
        card.addEventListener('mousemove', function (e) {
          const r = card.getBoundingClientRect();
          const cx = (e.clientX - r.left) / r.width - 0.5; // -0.5 … 0.5
          const cy = (e.clientY - r.top) / r.height - 0.5;
          card.style.setProperty('--tilt-x', -cy * 12 + 'deg');
          card.style.setProperty('--tilt-y', cx * 12 + 'deg');
          card.style.transform =
            'translate(-50%,-50%) ' +
            'rotateX(calc(var(--rx,0deg) + var(--tilt-x,0deg))) ' +
            'rotateY(calc(var(--ry,0deg) + var(--tilt-y,0deg))) ' +
            'translateZ(80px) scale(1.05)';
        });
        card.addEventListener('mouseleave', function () {
          card.style.transform = '';
        });
      });
    })();

    /* ════════════════════════════════════════
   ORBIT RINGS
════════════════════════════════════════ */
    (function () {
      const el = document.getElementById('orbits');
      const DATA = [
        { r: 0.38, spd: '42s', labels: ['Angular', 'Signals', 'NgRx', 'RxJS'] },
        {
          r: 0.55,
          spd: '57s',
          labels: [
            'TypeScript',
            'Generics',
            'Utility Types',
            'Branded Types',
            'Conditional',
          ],
        },
        {
          r: 0.7,
          spd: '46s',
          labels: [
            'React 19',
            'Server Components',
            'App Router',
            'Next.js 15',
            'Hooks',
          ],
        },
        {
          r: 0.86,
          spd: '68s',
          labels: [
            'Node.js',
            'GraphQL',
            'Auth',
            'WebSockets',
            'Edge',
            'SSR',
            'Testing',
          ],
        },
      ];
      const W = el.offsetWidth;
      DATA.forEach(function (od, ri) {
        const ring = document.createElement('div');
        ring.className = 'orbit-ring';
        ring.style.setProperty('--spd', od.spd);
        ring.style.inset = (0.5 - od.r / 2) * 100 + '%';
        od.labels.forEach(function (text, i) {
          const angle = (i / od.labels.length) * 360;
          const lbl = document.createElement('span');
          lbl.className = 'orbit-label';
          lbl.textContent = text;
          lbl.style.setProperty('--spd', od.spd);
          const rad = (angle * Math.PI) / 180;
          const rx = (od.r / 2) * W;
          lbl.style.left = 'calc(50% + ' + Math.cos(rad) * rx + 'px)';
          lbl.style.top = 'calc(50% + ' + Math.sin(rad) * rx + 'px)';
          lbl.style.transform =
            'translate(-50%,-50%) rotate(' + (angle + 90) + 'deg)';
          lbl.style.animation = 'counterSpin ' + od.spd + ' linear infinite';
          if (ri % 2 === 1) lbl.style.animationDirection = 'reverse';
          ring.appendChild(lbl);
        });
        el.insertBefore(ring, el.querySelector('.orbit-center'));
      });
    })();
  </script>
</section>
