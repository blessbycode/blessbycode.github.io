---

---

<div class="banner-series">
  <div class="ruled"></div>
  <div class="grain"></div>
  <div class="ghost" aria-hidden="true">VI</div>

  <!-- LEFT: TEXT -->
  <div class="series-left">
    <div class="eyebrow">
      <span class="ey-rule"></span>
      Series · blessbycode
    </div>
    <div class="headline">
      <span class="hl-a">written in</span>
      <span class="hl-b"><span class="amber">volumes.</span></span>
      <span class="hl-c">read the full arc.</span>
    </div>
    <p class="sub">
      Each series is a complete journey — written in order, built to be
      finished, nothing left assumed.
    </p>
  </div>

  <!-- RIGHT: SHELF -->
  <div class="series-right">
    <div class="shelf-shadow"></div>
    <div class="shelf-base"></div>
    <div class="books" id="books"></div>
  </div>
</div>

<style is:inline>
  .banner-series {
    flex: 1;
    min-height: 420px;
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  /* ─── NOTEBOOK RULED LINES (CSS only) ────────── */
  .ruled {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        transparent 8vw,
        rgba(180, 40, 40, 0.055) 8vw,
        rgba(180, 40, 40, 0.055) calc(8vw + 1px),
        transparent calc(8vw + 1px)
      ),
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 31px,
        rgba(80, 120, 220, 0.04) 31px,
        rgba(80, 120, 220, 0.04) 32px
      );
  }

  [data-theme='light'] .ruled {
    background:
      linear-gradient(
        90deg,
        transparent 8vw,
        rgba(220, 50, 50, 0.07) 8vw,
        rgba(220, 50, 50, 0.07) calc(8vw + 1px),
        transparent calc(8vw + 1px)
      ),
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 31px,
        rgba(60, 90, 200, 0.05) 31px,
        rgba(60, 90, 200, 0.05) 32px
      );
  }

  /* ─── GRAIN ──────────────────────────────────── */
  .grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.78' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 190px;
    opacity: 0.055;
  }

  [data-theme='light'] .grain {
    opacity: 0.045;
  }

  /* ─── GHOST NUMERAL ──────────────────────────── */
  .ghost {
    position: absolute;
    right: -2vw;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-primary);
    font-size: clamp(12rem, 28vw, 26rem);
    font-weight: 900;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.08em;
    user-select: none;
    pointer-events: none;
    z-index: 0;
    color: rgba(237, 230, 214, 0.02);
    -webkit-text-stroke-color: rgba(237, 230, 214, 0.025);
    -webkit-text-stroke: 1px;
    animation: ghostBreath 9s ease-in-out infinite;
  }

  [data-theme='light'] .ghost {
    color: rgba(26, 21, 16, 0.025);
    -webkit-text-stroke-color: rgba(26, 21, 16, 0.03);
  }
  @keyframes ghostBreath {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  /* ─── LEFT: TEXT ─────────────────────────────── */
  .series-left {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 5vw 60px calc(8vw + 16px);
  }

  /* col divider */
  .series-left::after {
    content: '';
    position: absolute;
    right: 0;
    top: 12%;
    bottom: 12%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(237, 230, 214, 0.06),
      transparent
    );
  }

  [data-theme='light'] .series-left::after {
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(26, 21, 16, 0.08),
      transparent
    );
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    margin-bottom: 20px;
    opacity: 0;
    animation: riseIn 0.55s ease 0.1s forwards;
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(237, 230, 214, 0.22);
  }

  [data-theme='light'] .eyebrow {
    color: rgba(26, 21, 16, 0.25);
  }

  .ey-rule {
    width: 32px;
    height: 1px;
    background: linear-gradient(90deg, transparent, currentColor);
    opacity: 0.4;
  }

  .headline {
    line-height: 0.88;
    letter-spacing: -0.05em;
    margin-bottom: 24px;
  }
  .hl-a {
    display: block;
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 200;
    font-style: italic;
    color: rgba(237, 230, 214, 0.32);
    opacity: 0;
    animation: riseIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.22s forwards;
  }

  [data-theme='light'] .hl-a {
    color: rgba(26, 21, 16, 0.28);
  }

  .hl-b {
    display: block;
    font-size: clamp(4rem, 8vw, 7.5rem);
    font-weight: 900;
    color: #ede6d6;
    opacity: 0;
    animation: riseIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.36s forwards;
  }

  [data-theme='light'] .hl-b {
    color: #1a1510;
  }

  .hl-c {
    display: block;
    font-size: clamp(2rem, 3.8vw, 3.4rem);
    font-weight: 300;
    font-style: italic;
    color: rgba(237, 230, 214, 0.38);
    opacity: 0;
    animation: riseIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
  }

  [data-theme='light'] .hl-c {
    color: rgba(26, 21, 16, 0.32);
  }

  /* amber shimmer */
  .amber {
    background: linear-gradient(110deg, #c8943a 0%, #eabb50 45%, #c8943a 100%);
    background-size: 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: amberShift 5s ease-in-out infinite;
  }
  [data-theme='light'] .amber {
    background: linear-gradient(110deg, #8a6010 0%, #b08020 45%, #8a6010 100%);
    background-size: 200%;
    -webkit-background-clip: text;
    background-clip: text;
  }
  @keyframes amberShift {
    0%,
    100% {
      background-position: 0%;
    }
    50% {
      background-position: 100%;
    }
  }

  .sub {
    font-size: clamp(0.85rem, 1.3vw, 0.95rem);
    font-weight: 200;
    font-style: italic;
    max-width: 320px;
    line-height: 1.72;
    color: rgba(237, 230, 214, 0.28);
    opacity: 0;
    animation: riseIn 0.55s ease 0.65s forwards;
  }

  [data-theme='light'] .sub {
    color: rgba(26, 21, 16, 0.28);
  }

  /* ─── RIGHT: BOOK SHELF (pure CSS) ──────────── */
  .series-right {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 0;
    overflow: hidden;
  }

  /* shelf base line */
  .shelf-base {
    position: absolute;
    bottom: 18%;
    left: 4%;
    right: 4%;
    height: 2px;
    z-index: 2;
    border-radius: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(237, 230, 214, 0.14),
      transparent
    );
  }

  [data-theme='light'] .shelf-base {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(26, 21, 16, 0.16),
      transparent
    );
  }

  /* shelf drop shadow */
  .shelf-shadow {
    position: absolute;
    bottom: calc(18% - 8px);
    left: 8%;
    right: 8%;
    height: 12px;
    z-index: 1;
    filter: blur(8px);
    background: rgba(0, 0, 0, 0.45);
  }

  [data-theme='light'] .shelf-shadow {
    background: rgba(0, 0, 0, 0.12);
  }

  /* books wrapper */
  .books {
    position: absolute;
    bottom: 18%;
    display: flex;
    align-items: flex-end;
    gap: 5px;
    opacity: 0;
    animation: riseIn 0.7s ease 0.3s forwards;
  }

  /* individual spine */
  .book {
    position: relative;
    border-radius: 2px 2px 0 0;
    cursor: pointer;
    transform-origin: bottom center;
    /* default subtle lean */
    transition:
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.4s;
    overflow: visible;
  }
  .book:nth-child(odd) {
    transform: rotate(-0.7deg);
  }
  .book:nth-child(even) {
    transform: rotate(0.5deg);
  }

  /* ── HOVER: snap upright, lift off shelf ── */
  .book:hover {
    transform: rotate(0deg) translateY(-20px) !important;
    box-shadow:
      0 24px 40px rgba(0, 0, 0, 0.55),
      4px 0 10px rgba(0, 0, 0, 0.3) !important;
    z-index: 10;
  }

  [data-theme='light'] .book:hover {
    box-shadow:
      0 20px 36px rgba(0, 0, 0, 0.18),
      4px 0 8px rgba(0, 0, 0, 0.12) !important;
  }

  /* spine inner */
  .book-inner {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px 2px 0 0;
    overflow: hidden;
    position: relative;
  }

  /* left highlight edge */
  .book-inner::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0.14),
      transparent
    );
    border-radius: 2px 0 0 0;
  }

  /* top cap */
  .book-cap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    border-radius: 2px 2px 0 0;
    background: rgba(255, 255, 255, 0.07);
  }

  /* vol label — rotated, no series name */
  .book-vol {
    font-family: var(--font-mono);
    font-size: 0.46rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    padding: 18px 0;
    user-select: none;
    position: relative;
    z-index: 1;
    opacity: 0.45;
    transition: opacity 0.3s;
  }
  .book:hover .book-vol {
    opacity: 0.8;
  }

  /* ── extending chapter-index rule on hover ── */
  .book-rule {
    position: absolute;
    /* rule extends from left edge of spine to the left */
    top: 38%;
    right: calc(100% + 0px);
    height: 1px;
    width: 0;
    background: rgba(237, 230, 214, 0.22);
    transition:
      width 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      right 0.45s;
  }
  .book:hover .book-rule {
    width: 50px;
    right: calc(100% + 6px);
  }

  [data-theme='light'] .book-rule {
    background: rgba(26, 21, 16, 0.22);
  }

  /* small arrowhead at end of rule */
  .book-rule::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    border-right: 4px solid rgba(237, 230, 214, 0.3);
    opacity: 0;
    transition: opacity 0.2s 0.3s;
  }
  .book:hover .book-rule::before {
    opacity: 1;
  }

  [data-theme='light'] .book-rule::before {
    border-right: 4px solid rgba(26, 21, 16, 0.3);
  }

  /* vol number below spine on hover */
  .book-num {
    position: absolute;
    bottom: -22px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.4rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(237, 230, 214, 0.6);
    opacity: 0;
    transition: opacity 0.3s 0.1s;
  }
  .book:hover .book-num {
    opacity: 0.45;
  }

  [data-theme='light'] .book-num {
    color: rgba(26, 21, 16, 0.55);
  }

  @keyframes riseIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script is:inline>
  /* ── BUILD SPINES — purely visual, no series names ── */
  const SPINES = [
    { w: 46, h: 240, bg: '#1B3A5A', text: 'rgba(168,210,245,.65)', vol: 'I' },
    { w: 42, h: 280, bg: '#2A1A4E', text: 'rgba(195,165,245,.65)', vol: 'II' },
    { w: 50, h: 220, bg: '#1A3C2A', text: 'rgba(140,215,170,.65)', vol: 'III' },
    { w: 44, h: 265, bg: '#4A2012', text: 'rgba(245,185,135,.65)', vol: 'IV' },
    { w: 48, h: 245, bg: '#3C1832', text: 'rgba(235,165,205,.65)', vol: 'V' },
    { w: 42, h: 260, bg: '#1E2A40', text: 'rgba(160,195,235,.65)', vol: 'VI' },
  ];

  const shelf = document.getElementById('books');
  SPINES.forEach((s, i) => {
    const book = document.createElement('div');
    book.className = 'book';
    book.style.cssText = `
      width:${s.w}px; height:${s.h}px;
      animation-delay:${0.35 + i * 0.065}s;
      box-shadow: 4px 0 12px rgba(0,0,0,.5), inset -2px 0 0 rgba(0,0,0,.3);
    `;

    const inner = document.createElement('div');
    inner.className = 'book-inner';
    inner.style.background = s.bg;

    const cap = document.createElement('div');
    cap.className = 'book-cap';

    const vol = document.createElement('div');
    vol.className = 'book-vol';
    vol.textContent = `Vol ${s.vol}`;
    vol.style.color = s.text;

    const rule = document.createElement('div');
    rule.className = 'book-rule';

    const num = document.createElement('div');
    num.className = 'book-num';
    num.textContent = `vol. ${s.vol}`;

    inner.appendChild(cap);
    inner.appendChild(vol);
    book.appendChild(inner);
    book.appendChild(rule);
    book.appendChild(num);
    shelf.appendChild(book);
  });
</script>
