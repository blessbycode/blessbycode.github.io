      <!-- repeat -->
      <span class="ticker-item">useDebounce</span>
      <span class="ticker-item">sleep &amp; retry</span>
      <span class="ticker-item">cx()</span>
      <span class="ticker-item">groupBy</span>
      <span class="ticker-item">formatDate</span>
      <span class="ticker-item">deepClone</span>
      <span class="ticker-item">throttle</span>
      <span class="ticker-item">parseJWT</span>
      <span class="ticker-item">useLocalStorage</span>
      <span class="ticker-item">tryCatch</span>
    </div>
    <div class="ticker-band">
      <span class="ticker-item">React</span>
      <span class="ticker-item">TypeScript</span>
      <span class="ticker-item">Node.js</span>
      <span class="ticker-item">CSS</span>
      <span class="ticker-item">Arrays</span>
      <span class="ticker-item">Async</span>
      <span class="ticker-item">DOM</span>
