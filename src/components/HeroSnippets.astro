  <!-- HEADLINE -->
  <div class="content">
    <div class="headline">
      <div class="h-row">
        <span class="h-word w1">the</span>
        <span class="h-word w2">CODE</span>
      </div>
      <div class="h-row">
        <span class="h-word w3">VAULT</span>
        <span class="h-word w4">—</span>
