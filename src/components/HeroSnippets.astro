      <span class="ticker-item">Auth</span>
      <span class="ticker-item">API</span>
      <span class="ticker-item">React</span>
      <span class="ticker-item">TypeScript</span>
      <span class="ticker-item">Node.js</span>
      <span class="ticker-item">CSS</span>
      <span class="ticker-item">Arrays</span>
      <span class="ticker-item">Async</span>
      <span class="ticker-item">DOM</span>
      <span class="ticker-item">Forms</span>
      <span class="ticker-item">Auth</span>
      <span class="ticker-item">API</span>
