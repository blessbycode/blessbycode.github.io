---

<div class="banner-tags">
  <!-- GRAPH PAPER SVG -->
  <svg
    class="grid-svg"
    viewBox="0 0 1200 500"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <defs>
      <pattern
        id="pgMinor"
        x="0"
        y="0"
        width="36"
        height="36"
        patternUnits="userSpaceOnUse"
      >
        <path d="M36,0 L0,0 0,36" fill="none"></path>
      </pattern>
      <pattern
        id="pgMajor"
        x="0"
        y="0"
        width="180"
        height="180"
        patternUnits="userSpaceOnUse"
      >
        <rect width="180" height="180" fill="url(#pgMinor)"></rect>
        <path d="M180,0 L0,0 0,180" fill="none"></path>
      </pattern>
    </defs>
    <g class="grid-group">
      <rect
        x="-100"
        y="-100"
        width="1400"
        height="700"
        fill="url(#pgMajor)"
        id="gridRect"></rect>
    </g>
  </svg>

  <div class="grain"></div>
  <div class="col-divider"></div>

  <!-- LEFT: TEXT -->
  <div class="tags-left">
    <div class="eyebrow">
      <span class="ey-dot"></span>Tags · blessbycode
    </div>
    <div class="headline">
      <span class="hl-a">every idea,</span>
      <span class="hl-b"><span class="vivid">mapped.</span></span>
      <span class="hl-c">browse the index.</span>
    </div>
    <p class="sub">
      Every piece of writing lives inside a web of ideas. Pick a thread and
      follow it wherever it leads.
    </p>
    <div class="rule"></div>
  </div>

  <!-- RIGHT: RING CLUSTER -->
  <div class="tags-right">
    <div class="ring-cluster" id="ringCluster"></div>
  </div>
</div>

<style is:inline>
  .banner-tags {
    /* flex: 1; */
    min-height: 400px;
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  /* ─── GRAPH PAPER SVG (no canvas) ───────────── */
  .grid-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: visible;
  }
  .grid-group {
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* hover the banner → grid shifts subtly */
  .banner-tags:hover .grid-group {
    transform: translate(-6px, -4px);
  }

  /* ─── GRAIN ──────────────────────────────────── */
  .grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 160px;
    opacity: 0.04;
  }

  [data-theme='github-light'] .grain {
    opacity: 0.035;
  }

  /* ─── LEFT: TEXT ─────────────────────────────── */
  .tags-left {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 6vw 60px calc(6vw);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    margin-bottom: 18px;
    color: rgba(221, 216, 255, 0.25);
    opacity: 0;
    animation: riseIn 0.55s ease 0.1s forwards;
  }
  [data-theme='github-light'] .eyebrow {
    color: rgba(18, 16, 42, 0.28);
  }

  /* dot pulse beside eyebrow */
  .ey-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    margin-right: 10px;
    vertical-align: middle;
    background: #a78bfa;
    animation: dotGlow 2.4s ease-in-out infinite;
  }

  [data-theme='github-light'] .ey-dot {
    background: #6d28d9;
  }
  @keyframes dotGlow {
    0%,
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
    50% {
      box-shadow: 0 0 0 4px rgba(167, 139, 250, 0.15);
    }
  }

  .headline {
    line-height: 0.88;
    letter-spacing: -0.05em;
    margin-bottom: 24px;
  }
  .hl-a {
    display: block;
    font-size: clamp(2rem, 4vw, 3.4rem);
    color: rgba(221, 216, 255, 0.35);
    font-weight: 300;
    font-style: italic;
    opacity: 0;
    animation: riseIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.22s forwards;
  }

  [data-theme='github-light'] .hl-a {
    color: rgba(18, 16, 42, 0.3);
  }

  .hl-b {
    display: block;
    font-size: clamp(4.5rem, 9vw, 8rem);
    font-weight: 900;
    color: #ddd8ff;
    opacity: 0;
    animation: riseIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.36s forwards;
  }

  [data-theme='github-light'] .hl-b {
    color: #12102a;
  }

  .hl-c {
    display: block;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: 300;
    font-style: italic;
    color: rgba(221, 216, 255, 0.38);
    opacity: 0;
    animation: riseIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
  }

  [data-theme='github-light'] .hl-c {
    color: rgba(18, 16, 42, 0.32);
  }

  /* vivid gradient on accent word */
  .vivid {
    background: linear-gradient(110deg, #a78bfa 0%, #60a5fa 55%, #a78bfa 100%);
    background-size: 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: vividShift 5s ease-in-out infinite;
  }
  [data-theme='github-light'] .vivid {
    background: linear-gradient(110deg, #6d28d9 0%, #2563eb 55%, #6d28d9 100%);
    background-size: 200%;
    -webkit-background-clip: text;
    background-clip: text;
  }
  @keyframes vividShift {
    0%,
    100% {
      background-position: 0%;
    }
    50% {
      background-position: 100%;
    }
  }

  .sub {
    font-size: clamp(0.85rem, 1.3vw, 0.95rem);
    font-weight: 300;
    font-style: italic;
    color: rgba(221, 216, 255, 0.3);
    max-width: 340px;
    line-height: 1.72;
    opacity: 0;
    animation: riseIn 0.55s ease 0.65s forwards;
  }
  [data-theme='github-light'] .sub {
    color: rgba(18, 16, 42, 0.3);
  }

  /* divider rule */
  .rule {
    margin-top: 22px;
    width: 48px;
    height: 1px;
    background: rgba(221, 216, 255, 0.15);
    opacity: 0;
    animation: riseIn 0.5s ease 0.8s forwards;
  }

  [data-theme='github-light'] .rule {
    background: rgba(18, 16, 42, 0.15);
  }

  /* ─── RIGHT: DECORATIVE RINGS ────────────────── */
  .tags-right {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    overflow: hidden;
  }

  /* ring cluster wrapper */
  .ring-cluster {
    position: relative;
    width: min(340px, 40vw);
    aspect-ratio: 1;
    flex-shrink: 0;
  }

  /* individual ring — pure CSS div, no canvas */
  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid;
    border-color: rgba(167, 139, 250, 0.12);
    transform: translate(-50%, -50%);
    transition:
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color 0.4s,
      box-shadow 0.4s;
    cursor: default;
  }

  /* ── HOVER: ring ripples outward + glows ── */
  .ring:hover {
    transform: translate(-50%, -50%) scale(1.12) !important;
    border-color: rgba(167, 139, 250, 0.6) !important;
    box-shadow:
      0 0 30px rgba(167, 139, 250, 0.18),
      inset 0 0 20px rgba(167, 139, 250, 0.06);
  }

  [data-theme='github-light'] .ring:hover {
    border-color: rgba(109, 40, 217, 0.5) !important;
    box-shadow:
      0 0 30px rgba(109, 40, 217, 0.12),
      inset 0 0 20px rgba(109, 40, 217, 0.04);
  }

  /* ripple pulse that plays once on hover */
  .ring::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 1px solid transparent;
    transition: all 0s;
  }
  .ring:hover::after {
    border-color: inherit;
    animation: rippleOut 0.7s ease forwards;
  }
  @keyframes rippleOut {
    from {
      transform: scale(1);
      opacity: 0.6;
    }
    to {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  /* ring colour variants */
  [data-theme='github-light'] .ring {
    border-color: rgba(109, 40, 217, 0.1);
  }
  .ring.accent {
    border-color: rgba(96, 165, 250, 0.15);
  }
  [data-theme='github-light'] .ring.accent {
    border-color: rgba(37, 99, 235, 0.12);
  }

  /* ─── VERTICAL DIVIDER between columns ───────── */
  .col-divider {
    position: absolute;
    top: 10%;
    bottom: 10%;
    left: 50%;
    width: 1px;
    z-index: 4;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(221, 216, 255, 0.06),
      transparent
    );
  }

  [data-theme='github-light'] .col-divider {
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(18, 16, 42, 0.08),
      transparent
    );
  }

  #pgMinor path {
    stroke: rgba(167, 139, 250, 0.055);
  }
  #pgMajor path {
    stroke: rgba(167, 139, 250, 0.11);
  }
  [data-theme='github-light'] #pgMinor path {
    stroke: rgba(109, 40, 217, 0.045);
  }
  [data-theme='github-light'] #pgMajor path {
    stroke: rgba(109, 40, 217, 0.09);
  }
  @keyframes riseIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script is:inline>
  /* ── BUILD DECORATIVE RINGS ── */
  const cluster = document.getElementById('ringCluster');

  const RINGS = [
    { cx: 50, cy: 50, r: 48, accent: false },
    { cx: 50, cy: 50, r: 36, accent: false },
    { cx: 50, cy: 50, r: 22, accent: true },
    { cx: 50, cy: 50, r: 10, accent: false },
    { cx: 30, cy: 30, r: 22, accent: true },
    { cx: 70, cy: 28, r: 18, accent: false },
    { cx: 74, cy: 68, r: 26, accent: true },
    { cx: 28, cy: 72, r: 20, accent: false },
    { cx: 50, cy: 18, r: 14, accent: true },
    { cx: 82, cy: 46, r: 16, accent: false },
    { cx: 16, cy: 50, r: 12, accent: true },
    { cx: 50, cy: 82, r: 14, accent: false },
  ];

  RINGS.forEach((rd, i) => {
    const el = document.createElement('div');
    el.className = 'ring' + (rd.accent ? ' accent' : '');
    const size = rd.r * 2;
    el.style.cssText = `
      left:${rd.cx}%;top:${rd.cy}%;
      width:${size}%;height:${size}%;
      animation:riseIn .6s ease ${0.2 + i * 0.055}s both;
    `;
    cluster.appendChild(el);
  });
</script>
