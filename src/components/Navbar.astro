---
import siteConfig from '~/site.config';
import Navlink from './Navlink.astro';
---

<nav class="navbar-header">
  {siteConfig.navLinks.map((link) => <Navlink link={link} />)}
</nav>

<style>
  .navbar-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (max-width: 768px) {
    .navbar-header {
      display: none;
    }
  }
</style>
