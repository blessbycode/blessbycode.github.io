---
import type { MarkdownHeading } from 'astro';
import TOCHeading from '~/components/TOCHeading.astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const filteredHeadings = headings.filter(
  ({ depth }) => depth >= 2 && depth <= 3,
);
---

<div class="toc-wrapper">
  <details open class="toc">
    <summary class="">Table of Contents</summary>
    <nav class="toc-nav">
      <ul class="toc-list-wrapper">
        {filteredHeadings.map((heading) => <TOCHeading heading={heading} />)}
      </ul>
    </nav>
  </details>
</div>

<script>
  const observerOptions = {
    rootMargin: '0px 0px -66%', // Trigger when heading is in top 1/3 of screen
    threshold: 1,
  };

  const setCurrentHeading = (entries: any) => {
    for (let entry of entries) {
      if (entry.isIntersecting) {
        // Remove active class from all links
        document
          .querySelectorAll('details.toc > nav > ul > li')
          .forEach((a) => a.classList.remove('active-heading'));
        // Add active class to current link
        const id = entry.target.getAttribute('id');

        document
          .querySelector(`details.toc > nav > ul > li > a[href='#${id}']`)
          ?.parentElement?.classList.add('active-heading');
      }
    }
  };

  const observer = new IntersectionObserver(setCurrentHeading, observerOptions);

  // Observe all h2 and h3 elements
  document
    .querySelectorAll('h2[id], h3[id]')
    .forEach((h) => observer.observe(h));
</script>

<style>
  details summary {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-muted);
    padding: var(--space-4) var(--space-5);
    border-bottom: var(--border-subtle);
    cursor: pointer;

    &::marker {
      content: '';
      display: none;
    }
  }

  .toc-wrapper {
    position: sticky;
    top: var(--space-25);
  }

  @media (max-width: 768px) {
    .toc-wrapper {
      position: static;
    }
  }

  .toc {
    background: var(--bg-surface);
    border: var(--border-subtle);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition:
      background var(--transition),
      border-color var(--transition);
  }

  .toc-nav {
    width: 100%;
    padding: var(--space-4) var(--space-5);
  }

  .toc-list-wrapper {
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    max-width: 100%;
    max-height: calc(var(--space-25) * 4);
    overflow-y: auto;
  }

  @media screen and (width < 768px) {
    .toc-list-wrapper {
      max-height: 100%;
    }
  }
</style>
