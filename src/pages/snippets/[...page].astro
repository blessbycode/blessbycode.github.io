---
import type { GetStaticPaths } from 'astro';
import { getSortedPosts } from '~/utils';
import siteConfig from '~/site.config';
import Card from '~/components/Card.astro';
import Pagination from '~/components/Pagination.astro';
import Layout from '~/layouts/Layout.astro';
import HeroSnippets from '~/components/HeroSnippets.astro';
import SectionHeader from '~/components/SectionHeader.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const sortedSnippets = await getSortedPosts('snippets');
  return paginate(sortedSnippets.reverse(), { pageSize: siteConfig.pageSize });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const pageTitle =
  'Snippets' + (page.currentPage > 1 ? ` - Page ${page.currentPage}` : '');
---

<Layout title={pageTitle} description="All Snippets in the archive">
  <HeroSnippets />
  <section class="content-section">
    <div class="container">
      <SectionHeader name="Archive">All Snippets</SectionHeader>

      <main class="article-grid">
        {page.data.map((post) => <Card post={post} />)}
      </main>
      <Pagination
        prevLink={page.url.prev ? page.url.prev : undefined}
        prevText="Newer Snippets"
        nextLink={page.url.next ? page.url.next : undefined}
        nextText="Older Snippets"
      />
    </div>
  </section>
</Layout>
